# .env.sample - Template for environment variables

# Neon Postgres connection strings (used via @scripture/db / Prisma)
# Pooled connection - used by the app at runtime
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Unpooled connection - used by Prisma Migrate
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"

# Google OAuth2 credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Server settings
PORT=3000

# Frontend URL to redirect to after a successful Google login
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Optional: session secret
SESSION_SECRET=your_session_secret_here
