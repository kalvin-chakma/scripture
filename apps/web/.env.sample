# Backend API base URL (Vite requires the VITE_ prefix to expose a var to client code)
# Local dev:
VITE_API_URL=http://localhost:3000
# Production (set this in the Vercel project's Environment Variables instead of committing it here):
# VITE_API_URL=https://your-backend.onrender.com

# Google OAuth Client ID (not a secret - safe to expose to the browser).
# Must match GOOGLE_CLIENT_ID on the backend, and this app's origin +
# /auth/google/callback must be an Authorized redirect URI on that OAuth client.
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
